PHOTO_DIR=/home/<your-user>/raspi-camera-web/data/photos
CAMERA_BACKEND=fswebcam
CAMERA_COMMAND=fswebcam
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAPTURE_TIMEOUT_SECONDS=15
MINIMUM_CAPTURE_INTERVAL_SECONDS=5
MAXIMUM_PHOTOS=100
# CSIカメラを使う場合は次を設定します。旧OSではCAMERA_COMMAND=libcamera-stillです。
# CAMERA_BACKEND=rpicam
# CAMERA_COMMAND=rpicam-still
# CAMERA_CAPTURE_DELAY_MS=1000
# Picamera2ライブ映像・動体検知録画では次を設定します。
# CAMERA_BACKEND=picamera2
# VIDEO_DIR=/home/<your-user>/raspi-camera-web/data/videos
# MAXIMUM_VIDEOS=20
# VIDEO_WIDTH=1280
# VIDEO_HEIGHT=720
# VIDEO_FPS=15
# VIDEO_BITRATE=2000000
# LIVE_STREAM_WIDTH=640
# LIVE_STREAM_HEIGHT=360
# LIVE_STREAM_FPS=5
# MOTION_THRESHOLD=12
# MOTION_MINIMUM_CONSECUTIVE_FRAMES=3
# MOTION_RECORD_SECONDS=20
# MOTION_COOLDOWN_SECONDS=30
